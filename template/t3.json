{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "public/favicon.svg",
  "defaultThreadEnvMode": "worktree",
  "scripts": [
    {
      "name": "Setup worktree",
      "command": "pnpm install && ([ -f .dev.vars ] || cp .dev.vars.example .dev.vars) && pnpm cf-typegen",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Dev app",
      "command": "pnpm dev",
      "icon": "play",
      "previewUrl": "http://localhost:5173"
    },
    {
      "name": "Check",
      "command": "pnpm typecheck && pnpm lint && pnpm run doctor && pnpm test",
      "icon": "lint"
    },
    {
      "name": "Build",
      "command": "pnpm build",
      "icon": "build"
    }
  ]
}
